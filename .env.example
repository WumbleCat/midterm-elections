# Copy to .env and fill in. Never commit .env.
# All keys are optional; connectors that need a key report BLOCKED until it is set.

# U.S. Census Bureau API key (ACS, PEP API, CPS microdata). Request: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# BLS API v2 registration key (raises daily query limits; v1 keyless endpoint is used when unset).
# Request: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# BEA API key (required for state GDP / personal income / RPP). Request: https://apps.bea.gov/API/signup/
BEA_API_KEY=

# FEC API key (api.open.fec.gov). DEMO_KEY works with low rate limits. Request: https://api.data.gov/signup/
FEC_API_KEY=DEMO_KEY

# Contact email sent in the HTTP User-Agent (BLS asks for one on bulk downloads).
ELECTIONDATA_CONTACT_EMAIL=

# Override the data directory (defaults to <repo>/data).
# ELECTIONDATA_DATA_DIR=

# Set to 0 to disable TLS verification (only for debugging corporate proxies; never in production).
# ELECTIONDATA_SSL_VERIFY=1
